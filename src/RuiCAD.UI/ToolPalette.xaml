<UserControl x:Class="RuiCAD.UI.ToolPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
    FontFamily="Microsoft YaHei UI" FontSize="13"
    UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary Source="PaletteTheme.xaml" />
    </UserControl.Resources>
    <Grid Margin="12,14,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,13">
            <TextBlock Text="KCAD" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="全屋定制绘图" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Groups" Margin="0,0,4,0" />
        </ScrollViewer>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="8,8,4,0" Text="点击命令开始绘图"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
